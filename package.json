{
  "name": "agent-cli-terminal",
  "displayName": "Agent CLI Terminal",
  "description": "Dedicated sidebar terminal for AI CLI agents (Claude, Codex, Gemini, etc.) running alongside VS Code's native terminal.",
  "version": "1.0.0",
  "publisher": "enthonyaraujo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/enthonyaraujo/agent-terminal-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/enthonyaraujo/agent-terminal-vscode/issues"
  },
  "homepage": "https://github.com/enthonyaraujo/agent-terminal-vscode#readme",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Terminal",
    "Other"
  ],
  "keywords": [
    "terminal",
    "ai",
    "agents",
    "cli",
    "sidebar"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:agentCliTerminal.view"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "agentCliTerminalContainer",
          "title": "Agent CLI Terminal",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "agentCliTerminalContainer": [
        {
          "type": "webview",
          "id": "agentCliTerminal.view",
          "name": "Agent CLI Terminal"
        }
      ]
    },
    "commands": [
      {
        "command": "agentCliTerminal.focus",
        "title": "Agent CLI Terminal: Focus",
        "category": "Agent CLI Terminal"
      },
      {
        "command": "agentCliTerminal.newTerminal",
        "title": "Agent CLI Terminal: New Terminal",
        "category": "Agent CLI Terminal",
        "icon": "$(plus)"
      },
      {
        "command": "agentCliTerminal.launchAgent",
        "title": "Agent CLI Terminal: Launch Agent",
        "category": "Agent CLI Terminal",
        "icon": "$(sparkle)"
      },
      {
        "command": "agentCliTerminal.killTerminal",
        "title": "Agent CLI Terminal: Kill Terminal",
        "category": "Agent CLI Terminal",
        "icon": "$(trash)"
      },
      {
        "command": "agentCliTerminal.showLog",
        "title": "Agent CLI Terminal: Show Output Log",
        "category": "Agent CLI Terminal"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentCliTerminal.launchAgent",
          "when": "view == agentCliTerminal.view",
          "group": "navigation@1"
        },
        {
          "command": "agentCliTerminal.newTerminal",
          "when": "view == agentCliTerminal.view",
          "group": "navigation@2"
        },
        {
          "command": "agentCliTerminal.killTerminal",
          "when": "view == agentCliTerminal.view",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentCliTerminal.focus",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "agentCliTerminal.newTerminal",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "agentCliTerminalFocus"
      },
      {
        "command": "agentCliTerminal.launchAgent",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "agentCliTerminalFocus"
      },
      {
        "command": "agentCliTerminal.killTerminal",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w",
        "when": "agentCliTerminalFocus"
      }
    ],
    "configuration": {
      "title": "Agent CLI Terminal",
      "properties": {
        "agentCliTerminal.agents": {
          "type": "array",
          "default": [
            {
              "name": "Claude Code",
              "command": "claude"
            },
            {
              "name": "Codex CLI",
              "command": "codex"
            },
            {
              "name": "Gemini CLI",
              "command": "gemini"
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Agent display name"
              },
              "command": {
                "type": "string",
                "description": "Command or CLI executable to run"
              }
            },
            "required": [
              "name",
              "command"
            ]
          },
          "description": "List of AI CLI agents configured for the agent launcher QuickPick."
        },
        "agentCliTerminal.copyOnSelect": {
          "type": "boolean",
          "default": false,
          "description": "Automatically copy selected text in terminal to clipboard."
        },
        "agentCliTerminal.ptyBackend": {
          "type": "string",
          "enum": [
            "auto",
            "node-pty",
            "python"
          ],
          "default": "auto",
          "description": "Pseudoterminal backend: 'auto' (tries node-pty first with automatic fallback to Python 3 on Linux/macOS), 'node-pty' (force native module), or 'python' (force Python 3 helper)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js --production",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.js\"",
    "package": "npm run build && npx @vscode/vsce package --githubBranch main"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.15.0-beta.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.97.0",
    "@vscode/vsce": "^3.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
